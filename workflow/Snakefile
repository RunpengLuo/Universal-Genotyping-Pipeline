import os
import sys
from datetime import datetime

import pandas as pd


configfile: os.path.join(workflow.basedir, "../config/config.yaml")


sys.path.insert(0, os.path.join(workflow.basedir, "../config"))
from const import (
    NONBULK_ASSAYS,
    BULK_ASSAYS,
    LONGREAD_ASSAYS,
    LONGREAD_PHASER,
    PANEL_PHASER,
    ALLOWED_ASSAY_TYPES,
    REFVERS,
    ASSAY_TYPE2MODALITY,
    ASSAY_TYPE2FEATURE_TYPE,
    get_phasing_panel_path,
    get_genetic_map_path,
)

_run_id = datetime.now().strftime("%Y%m%d_%H%M%S")

# Skip validation when no real config is provided (e.g., --conda-create-envs-only).
# Detected by checking that sample_file points to an existing file.
_has_config = (
    "workflow_mode" in config
    and config.get("sample_file") is not None
    and os.path.isfile(config["sample_file"])
)

if _has_config:
    ##################################################
    print("=== Configuration Parameters ===")
    for key, val in config.items():
        print(f"  {key}: {val}")
    print()

    workflow_mode = config["workflow_mode"]
    assert workflow_mode in {
        "bulk_genotyping",
        "single_cell_genotyping",
        "copytyping_preprocess",
    }

    configured_assay_types = config["assay_types"]
    invalid_assay_types = [
        a for a in configured_assay_types if a not in ALLOWED_ASSAY_TYPES
    ]
    assert not invalid_assay_types, f"invalid assay_types={invalid_assay_types}"
    if workflow_mode == "bulk_genotyping":
        configured_assay_types = [a for a in configured_assay_types if a in BULK_ASSAYS]
    elif workflow_mode in ["single_cell_genotyping", "copytyping_preprocess"]:
        configured_assay_types = [
            a for a in configured_assay_types if a in NONBULK_ASSAYS
        ]

    sample_df = pd.read_table(config["sample_file"])
    required_cols = ["SAMPLE", "REP_ID", "assay_type", "sample_type", "PATH_to_bam"]
    optional_cols = ["PATH_to_barcodes", "PATH_to_10x_ranger"]
    missing_cols = [c for c in required_cols if c not in sample_df.columns]
    assert not missing_cols, f"missing columns: {missing_cols}"
    assert sample_df["REP_ID"].notna().all(), "REP_ID has missing values"
    assert sample_df["PATH_to_bam"].notna().all(), "PATH_to_bam has missing values"
    assert all(
        st in ["normal", "tumor"] for st in sample_df["sample_type"]
    ), "sample_type must be {normal, tumor}"

    for c in optional_cols:
        if c not in sample_df.columns:
            sample_df[c] = pd.NA
    SAMPLE_ID = config["sample_id"]
    sample_df = sample_df.loc[
        (sample_df["SAMPLE"] == SAMPLE_ID)
        & (sample_df["assay_type"].isin(configured_assay_types))
    ].reset_index(drop=True)
    sample_df["modality"] = sample_df["assay_type"].map(ASSAY_TYPE2MODALITY)

    rep_ids = sample_df["REP_ID"].unique().tolist()
    assay_types = sample_df["assay_type"].unique().tolist()
    modalities = sample_df["modality"].unique().tolist()

    # bulk allele/combine outputs live under allele_dir/{stream}/ (WGS family or WES)
    bulk_stream = "bulkWES" if "bulkWES" in assay_types else "bulkWGS"

    if workflow_mode in ["single_cell_genotyping", "copytyping_preprocess"]:
        assert (
            sample_df["PATH_to_barcodes"].notna().all()
        ), "PATH_to_barcodes has missing values"
        assert (
            sample_df["PATH_to_10x_ranger"].notna().all()
        ), "PATH_to_10x_ranger has missing values"
        # validate per-replicate records
        for rep_id, rep_df in sample_df.groupby(by="REP_ID", sort=False):
            rep_assay_types = rep_df["assay_type"].unique().tolist()
            assert (
                len(rep_assay_types) <= 2
            ), "at most 2 data types allowed per replicate"
            if len(rep_assay_types) == 2:
                assert ("scRNA" in rep_assay_types) and ("scATAC" in rep_assay_types)
        if workflow_mode == "copytyping_preprocess":
            assert config.get("het_snp_vcf") is not None
            assert config.get("bb_file") is not None
    else:
        assert len(rep_ids) == len(
            sample_df
        ), "bulk mode must have no duplicated replicate IDs"
        if "bulkWES" in assay_types and len(assay_types) > 1:
            print("mix bulkWES with other bulk assays is unsupported")
            sys.exit(1)

    modality2bams = {}
    for modality, rows in sample_df.groupby("modality", sort=False):
        modality2bams[modality] = rows["PATH_to_bam"].tolist()

    assay2rep_ids = {}
    assay2sample_types = {}
    for assay_type, rows in sample_df.groupby("assay_type", sort=False):
        # bulk assays ordered normal-first so column 0 is the matched normal
        if assay_type in BULK_ASSAYS:
            rows = rows.sort_values(
                "sample_type", key=lambda s: s != "normal", kind="stable"
            )
        assay2rep_ids[assay_type] = rows["REP_ID"].tolist()
        assay2sample_types[assay_type] = rows["sample_type"].tolist()

    for assay_type in ALLOWED_ASSAY_TYPES:
        if assay_type not in assay2rep_ids:
            assay2rep_ids[assay_type] = []
            assay2sample_types[assay_type] = []

    get_data = {}
    for rep_id, rep_df in sample_df.groupby(by="REP_ID", sort=False):
        for _, row in rep_df.iterrows():
            assay_type = row["assay_type"]
            get_data[(assay_type, rep_id)] = [
                row["PATH_to_barcodes"],
                row["PATH_to_bam"],
                row["PATH_to_10x_ranger"],
            ]

    refvers = config.get("reference_version")
    if refvers not in REFVERS:
        print(
            f"WARNING: reference_version={refvers!r} is not natively supported: {REFVERS}."
        )

    ##################################################
    # parse workflow inputs

    genotype_bam = None
    phase_bams = None
    phaser = config.get("phaser", "undefined")

    run_genotyping = workflow_mode in ["bulk_genotyping", "single_cell_genotyping"]
    require_genetic_map = run_genotyping and phaser in PANEL_PHASER
    if run_genotyping:
        normal_bams = sample_df.loc[
            sample_df["sample_type"] == "normal", "PATH_to_bam"
        ].to_list()
        tumor_bams = sample_df.loc[
            sample_df["sample_type"] == "tumor", "PATH_to_bam"
        ].to_list()
        lr_normal_bams = sample_df.loc[
            (sample_df["sample_type"] == "normal")
            & (sample_df["assay_type"].isin(LONGREAD_ASSAYS)),
            "PATH_to_bam",
        ].to_list()
        lr_tumor_bams = sample_df.loc[
            (sample_df["sample_type"] == "tumor")
            & (sample_df["assay_type"].isin(LONGREAD_ASSAYS)),
            "PATH_to_bam",
        ].to_list()

        # TODO this is for bulk genotyping. single-cell genotyping used all BAMs via modality2bams
        _genotype_bams = lr_normal_bams or normal_bams or lr_tumor_bams or tumor_bams
        genotype_bam = _genotype_bams[0]

        # parse phasing inputs
        if phaser in PANEL_PHASER:
            # parse genetic maps
            gmap_path = config.get("gmap_path")
            assert gmap_path, f"gmap_path required for {phaser}"
            get_genetic_map = get_genetic_map_path(gmap_path)
            missing_gmaps = [
                get_genetic_map(c)
                for c in config["chromosomes"]
                if not os.path.exists(get_genetic_map(c))
            ]
            assert (
                not missing_gmaps
            ), f"failed to locate gmap files: {missing_gmaps[:3]}"

            # parse phasing panels
            phasing_panel = config["phasing_panel"]
            assert os.path.isdir(
                phasing_panel
            ), f"failed to locate phasing panel: {phasing_panel}"
            get_phasing_panel = get_phasing_panel_path(phasing_panel)
            missing_panels = [
                get_phasing_panel(c)
                for c in config["chromosomes"]
                if not os.path.exists(get_phasing_panel(c))
            ]
            assert (
                not missing_panels
            ), f"failed to locate panel files: {missing_panels[:3]}"
        elif phaser in LONGREAD_PHASER:
            assert lr_normal_bams or lr_tumor_bams, (
                f"phaser={phaser} requires at least one long-read bulk assay "
                f"({sorted(LONGREAD_ASSAYS)}) in the sample sheet for sample_id={SAMPLE_ID}"
            )
            phase_bams = (
                lr_normal_bams[0] if len(lr_normal_bams) > 0 else lr_tumor_bams[0]
            )
        else:
            raise ValueError(f"unknown phaser: {phaser}")

    ##################################################
    # final target files

    final_targets = []
    if workflow_mode == "bulk_genotyping":
        final_targets += [
            config["bb_dir"] + f"/{bulk_stream}/bb.tsv.gz",
            config["bb_dir"] + f"/{bulk_stream}/sample_ids.tsv",
            config["bb_dir"] + f"/{bulk_stream}/bb.Tallele.npz",
            config["bb_dir"] + f"/{bulk_stream}/bb.Aallele.npz",
            config["bb_dir"] + f"/{bulk_stream}/bb.Ballele.npz",
            config["bb_dir"] + f"/{bulk_stream}/bb.depth.npz",
            config["bb_dir"] + f"/{bulk_stream}/bb.rdr.npz",
        ]
    elif workflow_mode == "single_cell_genotyping":
        for assay_type in assay_types:
            final_targets += [
                config["bb_dir"] + f"/{assay_type}/bb.tsv.gz",
                config["bb_dir"] + f"/{assay_type}/sample_ids.tsv",
                config["bb_dir"] + f"/{assay_type}/bb.Tallele.npz",
                config["bb_dir"] + f"/{assay_type}/bb.Aallele.npz",
                config["bb_dir"] + f"/{assay_type}/bb.Ballele.npz",
                config["bb_dir"] + f"/{assay_type}/bb.Xcount.npz",
                config["bb_dir"] + f"/{assay_type}/barcodes.tsv.gz",
            ]
    elif workflow_mode == "copytyping_preprocess":
        for assay_type in assay_types:
            final_targets += [
                config["bb_dir"] + f"/{assay_type}/cnv_segments.tsv",
                config["bb_dir"] + f"/{assay_type}/bb.Xcount.npz",
                config["bb_dir"] + f"/{assay_type}/bb.Tallele.npz",
                config["bb_dir"] + f"/{assay_type}/bb.Aallele.npz",
                config["bb_dir"] + f"/{assay_type}/bb.Ballele.npz",
            ]

    ##################################################
    os.makedirs(config["qc_dir"], exist_ok=True)

    # entrypoint
    include: "rules/common.smk"
    include: "rules/genotype_snps.smk"
    include: "rules/phase_snps.smk"
    include: "rules/pileup_snps.smk"
    include: "rules/process_anndata.smk"
    include: "rules/phase_and_concat.smk"
    include: "rules/count_reads.smk"
    include: "rules/combine_counts.smk"

    if workflow_mode == "copytyping_preprocess":

        ruleorder: cnv_segmentation > combine_counts_nonbulk

    else:

        ruleorder: combine_counts_nonbulk > cnv_segmentation

    rule all:
        input:
            final_targets,
        default_target: True

else:

    # install conda env
    rule _conda_env_base:
        output:
            temp(".conda_env_base"),
        conda:
            "envs/base.yaml"
        shell:
            "touch {output}"

    rule _conda_env_tools:
        output:
            temp(".conda_env_tools"),
        conda:
            "envs/tools.yaml"
        shell:
            "touch {output}"

    rule _conda_env_phase:
        output:
            temp(".conda_env_phase"),
        conda:
            "envs/phase.yaml"
        shell:
            "touch {output}"

    rule all:
        input:
            ".conda_env_base",
            ".conda_env_tools",
            ".conda_env_phase",
        default_target: True
