    use_prebuilt_windows = _wf["use_prebuilt_windows"]
    window_streams = _wf["window_streams"]
    do_repliseq = _wf["do_repliseq"]
    window_size_wgs = _wf["window_size_wgs"]
    window_size_wes = _wf["window_size_wes"]
    genotype_files = _wf["genotype_files"]
    phase_files = _wf["phase_files"]
    get_genetic_map = _wf["get_genetic_map"]
    get_phasing_panel = _wf["get_phasing_panel"]
    final_targets = _wf["final_targets"]

    os.makedirs(config["qc_dir"], exist_ok=True)

    # entrypoint
